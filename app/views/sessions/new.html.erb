<h1 class="text-center mt-10" style="text-align:center; margin-top:40px;">
  Welcome to MessageMe - a complete Chat App
</h1>

<h4 class="ui center aligned medium icon header">
  <i class="circular orange power off icon"></i>
  Log in to continue
</h4>

<div class="ui placeholder segment">
  <div class="ui two column very relaxed stackable grid">
    <div class="column">
      <%= form_with url: login_path, local: true, class: "ui form" do |f| %>
        <% if flash[:alert] %>
          <div class="ui red message"><%= flash[:alert] %></div>
        <% end %>

        <div class="field">
          <label>Username</label>
          <%= text_field_tag :username, nil, placeholder: "Username", class: "ui left icon input" %>
          <i class="user icon"></i>
        </div>

        <div class="field">
          <label>Password</label>
          <%= password_field_tag :password, nil, placeholder: "Password", class: "ui left icon input" %>
          <i class="lock icon"></i>
        </div>

        <%= submit_tag "Login", class: "ui blue submit button" %>
      <% end %>
    </div>

    <div class="middle aligned column">
      <div class="ui big button">
        <i class="signup icon"></i>
        Sign Up
      </div>
    </div>
  </div>

  <div class="ui vertical divider">Or</div>
</div>
